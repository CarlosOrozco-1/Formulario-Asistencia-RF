        {
            "name": "Contrato HTTP",
            "item": [
                {
                    "name": "Ruta API Inexistente",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/api/ruta-inexistente",
                        "description": "Debe responder 404 con code NOT_FOUND y el contrato de error estándar."
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Contrato 404', function () {",
                                "    pm.response.to.have.status(404);",
                                "    pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                                "});"
                            ]
                        }
                    }],
                    "response": []
                },
                {
                    "name": "Ejemplo de Validación",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"nombre\": \"\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/grupos",
                        "description": "Debe responder 400 con code VALIDATION_ERROR y details por campo."
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('Contrato de validación', function () {",
                                "    const error = pm.response.json().error;",
                                "    pm.response.to.have.status(400);",
                                "    pm.expect(error.code).to.eql('VALIDATION_ERROR');",
                                "    pm.expect(error.details).to.be.an('array').that.is.not.empty;",
                                "});"
                            ]
                        }
                    }],
                    "response": []
                }
            ]
        }
