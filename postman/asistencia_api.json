{
    "info": {
        "_postman_id": "7d9c6b12-9c3a-4e8b-b1a3-c5d6e7f8g9h0",
        "name": "Gestión de Asistencia",
        "description": "API REST del sistema. Los errores usan { error: { code, message, details } }. Los POST de creación responden 201; validación 400; autenticación 401; permisos 403; recursos ausentes 404; conflictos 409.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Autenticación",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/auth/login",
                        "description": "Devuelve token y usuario. Credenciales inválidas responden INVALID_CREDENTIALS."
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "if (pm.response.code === 200) {",
                                "    pm.collectionVariables.set('jwt_token', pm.response.json().token);",
                                "}"
                            ]
                        }
                    }],
                    "response": []
                },
                {
                    "name": "Restaurar Sesión",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/api/auth/me",
                        "description": "Valida el JWT y devuelve el usuario activo de la sesión."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Público",
            "item": [
                {
                    "name": "Registrar Asistencia Pueblo",
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"categoria_id\": 1,\n    \"fecha\": \"2026-07-15\",\n    \"cantidad\": 5,\n    \"servicio\": \"Primer\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/publico/pueblo/asistencia",
                        "description": "Crea un registro público y responde 201. Valida categoría activa, fecha y cantidad."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Asistencias",
            "item": [
                {
                    "name": "Listar Asistencias",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/api/asistencias?fecha=2026-07-15&tipo=discipulado&miembro_id=1",
                        "description": "Filtros opcionales: fecha YYYY-MM-DD, tipo y miembro_id positivo."
                    },
                    "response": []
                },
                {
                    "name": "Crear Asistencia Discipulado",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"miembro_id\": 1,\n    \"grupo_id\": 1,\n    \"fecha\": \"2026-07-15\",\n    \"tipo\": \"discipulado\",\n    \"estado\": \"presente\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/asistencias",
                        "description": "Responde 201. Discipulado requiere miembro_id y estado."
                    },
                    "response": []
                },
                {
                    "name": "Crear Asistencia Pueblo",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"categoria_id\": 1,\n    \"fecha\": \"2026-07-15\",\n    \"tipo\": \"pueblo\",\n    \"cantidad\": 10,\n    \"servicio\": \"Primer\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/asistencias",
                        "description": "Responde 201. Pueblo requiere categoria_id y cantidad positiva."
                    },
                    "response": []
                },
                {
                    "name": "Guardar Asistencia Completa del Grupo",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"fecha\": \"2026-07-15\",\n    \"asistencias\": [\n        {\n            \"miembro_id\": 1,\n            \"estado\": \"presente\"\n        }\n    ]\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/asistencias/grupos/1",
                        "description": "Reemplaza atómicamente la asistencia de los miembros activos del grupo y la fecha."
                    },
                    "response": []
                },
                {
                    "name": "Actualizar Asistencia",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"estado\": \"reportado\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{base_url}}/api/asistencias/1",
                        "description": "Acepta estado, cantidad, servicio o grupo_servidores."
                    },
                    "response": []
                },
                {
                    "name": "Eliminar Asistencia",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": "{{base_url}}/api/asistencias/1"
                    },
                    "response": []
                },
                {
                    "name": "Obtener Resumen Dashboard",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/api/asistencias/resumen",
                        "description": "Devuelve registrosHoy, personasHoy, personasPorTipo y el resto del resumen."
                    },
                    "response": []
                }
            ]
        },
