{
    "name": "gestion-asistencia-server",
    "version": "1.0.0",
    "description": "API REST para Gestión de Asistencia",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "test": "node --test",
        "test:watch": "node --test --watch",
        "check": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 node --check",
        "verify": "npm run check && npm run test"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^12.11.1",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "jspdf": "^2.5.1",
        "jspdf-autotable": "^3.5.23"
    }
}
