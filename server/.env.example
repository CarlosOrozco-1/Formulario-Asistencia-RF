# Variables de entorno necesarias para el servidor
# Renombrar este archivo a .env y completar los valores reales
# ============================================================

# Puerto del servidor (opcional, 3000 por defecto)
PORT=3000

# Zona horaria usada para calcular la fecha operativa de asistencias y resúmenes
BUSINESS_TIME_ZONE=America/Mexico_City

# Secreto para firmar tokens JWT (OBLIGATORIO)
# Usa una cadena larga y aleatoria. Ejemplo de generacion en Linux:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
