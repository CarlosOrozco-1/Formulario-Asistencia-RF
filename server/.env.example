# Variables de entorno necesarias para el servidor
# Renombrar este archivo a .env y completar los valores reales
# ============================================================

# Puerto del servidor (opcional, 3000 por defecto)
PORT=3000

# Ruta de la base de datos para respaldos y contenedores
DB_PATH=./data/asistencias.db

# Zona horaria usada para calcular la fecha operativa de asistencias y resúmenes
BUSINESS_TIME_ZONE=America/Mexico_City

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=

# Tamaño máximo permitido para cuerpos JSON
JSON_BODY_LIMIT=1mb

# Ventanas y topes de control de abuso para autenticación y registros públicos
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# Secreto para firmar tokens JWT (OBLIGATORIO)
# Usa una cadena larga y aleatoria. Ejemplo de generacion en Linux:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
